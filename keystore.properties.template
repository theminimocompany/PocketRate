# Release signing configuration.
#
# 1. Copy this file to "keystore.properties" (same directory) and fill in the
#    real values. keystore.properties is gitignored — never commit it.
# 2. Generate your upload key once, if you haven't:
#      keytool -genkeypair -v -keystore pocketrate-upload.keystore \
#        -alias pocketrate -keyalg RSA -keysize 4096 -validity 10950
#    Store the .keystore file somewhere safe OUTSIDE this repo and outside
#    OneDrive — losing it before enrolling in Play App Signing means you can
#    never update the app again.
# 3. When you upload to Play Console, enroll in Play App Signing so Google
#    holds the app-signing key and this one is only the upload key.

storeFile=pocketrate-upload.keystore
storePassword=CHANGE_ME
keyAlias=pocketrate
keyPassword=CHANGE_ME
